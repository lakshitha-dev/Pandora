# ─── Secrets — NEVER commit ───────────────────────────────────────────────
# Azure AI Search F0 is API-key-only. A leaked key is a live key.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
local.settings.json

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

