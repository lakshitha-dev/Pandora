# ─────────────────────────────────────────────────────────────────────────
# Pandora Knowledge Guardian — environment template
#
# Copy the relevant block into <service>/.env and fill in real values.
# Real values come from Malindu via a PRIVATE channel — never a commit.
# This file holds DUMMY VALUES ONLY and is safe to commit.
# ─────────────────────────────────────────────────────────────────────────


# ═══ agent/ — RAG + agentic service (Lakshitha) ══════════════════════════

# Azure AI Foundry (Azure OpenAI)
# IMPORTANT: the base host is <resource>.services.ai.azure.com
# The <resource>.openai.azure.com host does NOT exist for a Foundry resource.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-foundry-api-key
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment NAMES as created in Foundry — these are chosen at deploy time
# and need not match the underlying model name. Verify before assuming.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Set true for gpt-5 / o-series reasoning models. Changes the request shape:
#   · max_completion_tokens instead of max_tokens
#   · temperature must be 1 (any other value returns HTTP 400)
#   · reasoning tokens consume the completion budget — budget generously
IS_REASONING_MODEL=true
CHAT_MAX_COMPLETION_TOKENS=16000

# Azure AI Search — ADMIN key (needed to create the index and upload docs;
# the query key is read-only and insufficient for ingestion).
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=pandora-knowledge

# Shared secret: the backend sends this as the X-Internal-Key header
AGENT_SERVICE_KEY=change-me

# Retrieval tuning
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=6
RERANK_SCORE_THRESHOLD=0.45

# Agentic layer
AGENTIC_ENABLED=true
AGENT_TIMEOUT_SECONDS=75
ORCHESTRATION_BUDGET_SECONDS=180
MAX_RETRIES=1

CORPUS_PATH=../Pandora_RAG_Knowledge_2026.md
LOG_LEVEL=INFO


# ═══ backend/ — API gateway (Manujaya) ═══════════════════════════════════

POSTGRES_CONNECTION_STRING=postgresql+psycopg://user:pass@host:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ═══ frontend/ — Next.js (Nipuna) ════════════════════════════════════════
# WARNING: anything prefixed NEXT_PUBLIC_ is visible in the browser.
# Never put a secret behind that prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
