# backend/ — gateway service. Copy to backend/.env and fill in.
# Names match docs/TECH_STACK.md § Environment Variables. Never commit the real file.

# --- Database -----------------------------------------------------------------
# Async driver. SQLAlchemy needs the +psycopg suffix.
POSTGRES_CONNECTION_STRING=postgresql+psycopg://postgres:postgres@localhost:5432/sme_assistant

# --- Auth (Supabase) ----------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-the-supabase-jwt-secret

# Day-0 escape hatch: skip JWT verification and run as a fixed dev user.
# NEVER true in Azure App Service config.
AUTH_DISABLED=false

# --- Agent service (internal, never publicly routable) ------------------------
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_KEY=replace-with-the-shared-internal-key

# Day-0 escape hatch: serve contract-exact fixtures instead of calling the agent
# service, so the frontend is unblocked before agent/ exists.
AGENT_STUB_MODE=false

# --- CORS ---------------------------------------------------------------------
# Comma-separated. Add the Static Web App origin once Malindu has provisioned it.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
