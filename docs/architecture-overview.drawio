                </mxCell>
                <mxCell id="ag2" value="🌊   INCIDENT INVESTIGATOR&#xa;&#xa;writes   Likely Causes&#xa;&#xa;Never declares a cause&#xa;unless a record confirms it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=19;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=3;verticalAlign=middle;spacing=10;fontColor=#12232E;" parent="1" vertex="1">
                    <mxGeometry x="676" y="356" width="566" height="180" as="geometry"/>
                </mxCell>
