                </mxCell>
                <mxCell id="orch" value="⚙️   ORCHESTRATOR&#xa;&#xa;Rewrites the question  ·  Rates severity W1–W4 on the corpus&#39;s own scale  ·  Decides who works on it&#xa;It never writes report content — it decides, then checks the work" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=22;fontStyle=1;fillColor=#E6E0F0;strokeColor=#9673a6;strokeWidth=3;verticalAlign=middle;spacing=10;fontColor=#12232E;" parent="1" vertex="1">
                    <mxGeometry x="540" y="160" width="1310" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="parlabel" value="▼   ALL THREE RUN AT THE SAME TIME   —   three agents cost about as much time as one   ▼" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="70" y="308" width="1780" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ag1" value="🐋   MARINE-LIFE PROTECTOR&#xa;&#xa;writes   Affected Species&#xa;&#xa;Never mixes two species —&#xa;each one from its own record" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=19;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=3;verticalAlign=middle;spacing=10;fontColor=#12232E;" parent="1" vertex="1">
