                <mxCell id="rag" value="RAG ENGINE" style="swimlane;html=1;startSize=44;fontSize=22;fontStyle=1;fillColor=#EAF3E7;strokeColor=#82B366;strokeWidth=3;rounded=1;arcSize=3;fontColor=#12232E;" parent="1" vertex="1">
                    <mxGeometry x="70" y="596" width="1300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="rag1" value="1 · SEARCH&#xa;&#xa;by keyword + by meaning,&#xa;fused automatically&#xa;&#xa;filtered to the record types&#xa;this agent cares about&#xa;→ keep the best 6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=17;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;verticalAlign=middle;spacing=8;fontColor=#12232E;" parent="rag" vertex="1">
                    <mxGeometry x="24" y="56" width="400" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="rag2" value="2 · WRITE&#xa;&#xa;CLOSED BOOK — only those&#xa;6 records, nothing the model&#xa;already &quot;knows&quot;&#xa;&#xa;every fact tagged with the&#xa;record ID it came from" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=17;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;verticalAlign=middle;spacing=8;fontColor=#12232E;" parent="rag" vertex="1">
                    <mxGeometry x="448" y="56" width="400" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="rag3" value="3 · VERIFY&#xa;&#xa;The corpus&#39;s own 8 grounding&#xa;rules, checked IN CODE&#xa;&#xa;A prompt can be ignored.&#xa;A check cannot.&#xa;&quot;8/8 passed · 96% grounded&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=17;fillColor=#FBE4E3;strokeColor=#B85450;strokeWidth=2;verticalAlign=middle;spacing=8;fontColor=#12232E;" parent="rag" vertex="1">
                    <mxGeometry x="872" y="56" width="404" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="kb" value="KNOWLEDGE BASE&lt;br&gt;&lt;br&gt;Azure AI Search&lt;br&gt;&lt;br&gt;The Pandora corpus, cut so that&lt;br&gt;ONE RECORD = ONE CHUNK&lt;br&gt;— never split, never merged&lt;br&gt;&lt;br&gt;195 chunks  ·  149 records" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=16;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=3;verticalAlign=middle;spacing=8;fontColor=#12232E;" parent="1" vertex="1">
