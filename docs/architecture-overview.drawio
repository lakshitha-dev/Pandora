                <mxCell id="q" value="Guardian describes&#xa;what they see&#xa;&#xa;&quot;the water near Awa Reef&#xa;turned turquoise&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=19;fontStyle=1;fillColor=#F2F5F7;strokeColor=#8A9BA8;strokeWidth=2;verticalAlign=middle;spacing=8;fontColor=#12232E;" parent="1" vertex="1">
